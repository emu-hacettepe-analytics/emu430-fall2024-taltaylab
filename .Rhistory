library(shiny)
library(leaflet)
library(sf)
library(readxl)
library(dplyr)
# Load spatial data (Gambia map)
gambia_map <- st_read("/Users/tutkualtay/Downloads/gadm41_GMB_shp")
# Load data from the Excel file with the correct path
lcg_final <- read_excel("/Users/tutkualtay/Downloads/LCG_Results3.xlsx", sheet = "LCG Final")
generation <- read_excel("/Users/tutkualtay/Downloads/LCG_Results3.xlsx", sheet = "Generation")
# Debugging: Confirm column names
print("LCG Final Columns:")
print(colnames(lcg_final))
print("Generation Columns:")
print(colnames(generation))
# Ensure "Hour" and "Region" exist in the data
if (!("Hour" %in% colnames(lcg_final)) || !("Region" %in% colnames(generation))) {
stop("Ensure that 'Hour' exists in the LCG Final sheet and 'Region' exists in the Generation sheet.")
}
# Merge Hour with Generation data while preserving all columns
data <- lcg_final %>%
rename(Hour = Hour) %>%  # Ensure correct column name
mutate(dummy_key = 1) %>%
full_join(generation %>% mutate(dummy_key = 1), by = "dummy_key") %>%
select(-dummy_key)  # Remove helper key column
# Debugging: Print a sample of the merged data
print("Merged data sample:")
print(head(data))
# Ensure unique values for dropdown choices
unique_hours <- unique(data$Hour)
# Define the Shiny UI
ui <- fluidPage(
titlePanel("Gambia Electricity Generation and Consumption Map"),
sidebarLayout(
sidebarPanel(
selectInput("hour", "Select Hour:", choices = unique_hours),  # Dropdown for hour selection
h5("Click on a region to see detailed data.")
),
mainPanel(
leafletOutput("map"),    # Map output
tableOutput("details")   # Table for clicked region details
)
)
)
