full_join(generation %>% mutate(dummy_key = 1), by = "dummy_key") %>%
select(-dummy_key)  # Remove helper key column
# Debugging: Print a sample of the merged data
print("Merged data sample:")
print(head(data))
# Ensure unique values for dropdown choices
unique_hours <- unique(data$Hour)
# Define the Shiny UI
ui <- fluidPage(
titlePanel("Gambia Electricity Generation and Consumption Map"),
sidebarLayout(
sidebarPanel(
selectInput("hour", "Select Hour:", choices = unique_hours),  # Dropdown for hour selection
h5("Click on a region to see detailed data.")
),
mainPanel(
leafletOutput("map"),    # Map output
tableOutput("details")   # Table for clicked region details
)
)
)
# Define the Shiny server logic
server <- function(input, output, session) {
# Render the map
output$map <- renderLeaflet({
leaflet(gambia_map) %>%
addTiles() %>%
addPolygons(
color = "black",
fillColor = "blue",
weight = 1,
layerId = ~NAME_1  # Use the region name as the layer ID
)
})
# Handle map click event
observeEvent(input$map_shape_click, {
clicked_region <- input$map_shape_click$id  # Get clicked region ID
# Debugging: Print clicked region and selected hour
print(paste("Clicked region:", clicked_region))
print(paste("Selected hour:", input$hour))
# Filter data for the clicked region and selected hour
filtered_data <- data %>%
filter(Region == clicked_region & Hour == input$hour)
# Debugging: Print filtered data
print("Filtered data:")
print(filtered_data)
# Display filtered data in the details table
output$details <- renderTable({
if (nrow(filtered_data) == 0) {
return(data.frame(Message = "No data available for this selection"))
}
filtered_data
})
})
}
# Run the Shiny app
shinyApp(ui, server)
