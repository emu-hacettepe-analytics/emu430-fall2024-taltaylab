# Load required libraries
library(shiny)
library(leaflet)
library(sf)
library(readxl)
library(dplyr)
library(tidyr)
# Load spatial data (Gambia map)
gambia_map <- st_read("/Users/tutkualtay/Downloads/gadm41_GMB_shp")
# Normalize region names in shapefile
gambia_map$NAME_1 <- tolower(trimws(gambia_map$NAME_1))
# Split "Central River" into two sub-regions based on longitude
gambia_map <- gambia_map %>%
mutate(
NAME_1 = case_when(
NAME_1 == "central river" & st_coordinates(.)[, 1] < median(st_coordinates(.)[, 1]) ~ "central river west",
NAME_1 == "central river" & st_coordinates(.)[, 1] >= median(st_coordinates(.)[, 1]) ~ "central river east",
TRUE ~ NAME_1
)
)
